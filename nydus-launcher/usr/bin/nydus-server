#!/usr/bin/python3

import datetime
import random
import socket
import ssl
import time
import threading
import traceback

from nydus.common import nydus_info
from nydus.common import validity
from nydus.common.MCAccount import MCAccount

from nydus.common.net_constants import ALLOC_DELIMS
from nydus.common.net_constants import DELIM_CHAR
from nydus.common.net_constants import MSG_END
from nydus.common.net_constants import NETENC
from nydus.common.net_constants import RELEASE_COMMAND
from nydus.common.net_constants import RENEW_COMMAND
from nydus.common.net_constants import REQUEST_COMMAND
from nydus.common.net_constants import USERS_COMMAND

from nydus.server import alloc_utils
from nydus.server import netauth
from nydus.server.allocater import AllocEngine
from nydus.server.log import log_server
from nydus.server.log import restart_server_log
from nydus.server.ServerConfig import ServerConfig

# The lock which controls access to the account allocation file
ALLOCDB_LOCK = threading.Lock()

MAXMSG = 1024

ALLOC_BASE = DELIM_CHAR.join(["{}"] * (ALLOC_DELIMS+1)) + "\n"

SRV_TIMEOUT = 5

# 30 minutes in seconds
CLEANUP_PERIOD = 30 * 60
CLEANUP_DT = datetime.timedelta(seconds=CLEANUP_PERIOD)


# Entry point to the nydus-launcher server.
# Runs as a daemon which clients connect to.
# Creates threads to allocate accounts.
# Periodically cleans up account allocations in case a client didn't release.

def allocate_account(cfg, conn, addr, sys_username):
    # Allocate a Minecraft account to that username
    # and that IP address

    client_ip = addr[0]

    version = cfg.get_mc_version()

    with ALLOCDB_LOCK:
        alloc_engine = AllocEngine(cfg.get_alloc_file())
        mc_account = alloc_engine.allocate_one_account(client_ip, sys_username)

    # Error to handle: no account could be obtained
    # TODO what kind of exception?
    if mc_account == None:
        log_server("Could not allocate a Minecraft account to IP {}, username {}".format(\
                client_ip, sys_username))
        raise Exception("Could not allocate a Minecraft account when requested")
    mc_username = mc_account.get_mc_username()
    mc_uuid = mc_account.get_mc_uuid()
    mc_token = mc_account.get_mc_token()

    allocation_str = ALLOC_BASE.format(version,
            mc_username, mc_uuid, mc_token)

    allocation_data = allocation_str.encode(encoding=NETENC)

    sent_data = 0
    while sent_data < len(allocation_data):
        sent_data += conn.send(allocation_data[sent_data:])

def renew_account(cfg, conn, addr, sys_username):
    # Renew the allocation on that address

    client_ip = addr[0]

    with ALLOCDB_LOCK:
        alloc_engine = AllocEngine(cfg.get_alloc_file())
        alloc_engine.renew_one_account(client_ip, sys_username)

def release_account(cfg, conn, addr, sys_username):
    # Release the account on that address

    client_ip = addr[0]

    with ALLOCDB_LOCK:
        alloc_engine = AllocEngine(cfg.get_alloc_file())
        alloc_engine.release_one_account(client_ip, sys_username)

def show_users(cfg, conn):
    # Send the client a list of all allocated Minecraft accounts
    # and corresponding system usernames

    with ALLOCDB_LOCK:
        alloc_engine = AllocEngine(cfg.get_alloc_file())
        users_table = alloc_engine.user_show()

    # The default form of the table is formatted with
    # newlines, but the newline is the "end of message" signal
    # in Nydus socket communication, so we need to replace
    # the newline with something else before sending it.
    
    users_table = users_table.strip().replace(MSG_END, DELIM_CHAR)

    # We do still need an 'end of message' character on the end
    users_table += "\n"

    users_data = users_table.encode(encoding=NETENC)

    sent_data = 0
    while sent_data < len(users_data):
        sent_data += conn.send(users_data[sent_data:])

def handle_connection(cfg, conn, addr):
    try:
        client_exchange(cfg, conn, addr)
    except TimeoutError:
        log_server("Client {} took too long to respond".format(addr))
    except Exception:
        error_msg = traceback.format_exc()
        log_server(error_msg)
    finally:
        conn.close()


def client_exchange(cfg, conn, addr):

    str_data = ""

    # Don't keep receiving data forever
    # We don't want the clients to be able to consume all our memory
    # If they exceed this limit they're doing something wrong anyway.

    # Cover the whole communication in try/except
    # so that if something goes wrong we can still close the 
    # connection as a signal to the client.
    recv_start = datetime.datetime.now()
    while len(str_data) < MAXMSG:

        new_data = conn.recv(MAXMSG)

        # Empty data means the other end of the connection is closed
        # We can discard this exchange.
        if len(new_data) == 0:
            return

        str_data += new_data.decode(encoding=NETENC)

        # A newline character signals end of message
        if MSG_END in str_data:
            break

        now = datetime.datetime.now()
        if now - recv_start > datetime.timedelta(seconds=SRV_TIMEOUT):
            raise TimeoutError("Client took too long to respond")

    # The space is intentional; there should be a space between
    # the command and the username
    if str_data.startswith(REQUEST_COMMAND + " "):
        sys_username = str_data[len(REQUEST_COMMAND) + 1:]

        # Check the username exists and is real;
        # check again with whitespace removed if necessary
        # If we can't confirm username is real, terminate connection.

        if validity.is_valid_system_username(sys_username):
            allocate_account(cfg, conn, addr, sys_username)
        elif validity.is_valid_system_username(sys_username.strip()):
            allocate_account(cfg, conn, addr, sys_username.strip())

    elif str_data.startswith(RENEW_COMMAND + " "):
        sys_username = str_data[len(RENEW_COMMAND) + 1:]

        if validity.is_valid_system_username(sys_username):
            renew_account(cfg, conn, addr, sys_username)
        elif validity.is_valid_system_username(sys_username.strip()):
            renew_account(cfg, conn, addr, sys_username.strip())

    elif str_data.startswith(RELEASE_COMMAND + " "):
        sys_username = str_data[len(RELEASE_COMMAND) + 1:]
        
        if validity.is_valid_system_username(sys_username):
            release_account(cfg, conn, addr, sys_username)
        elif validity.is_valid_system_username(sys_username.strip()):
            release_account(cfg, conn, addr, sys_username.strip())

    elif str_data.startswith(USERS_COMMAND):

        show_users(cfg, conn)

    else:
        log_server("Invalid connection from host {}".format(addr))


def startup():
    cfg = ServerConfig()
    return cfg


def server_listener(cfg):
    context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)

    # Error to handle: what if cert file and cert key can't be found/files don't exist/permission denied?
    context.load_cert_chain(cfg.get_cert_file(), cfg.get_cert_privkey())

    # Error to handle: what if desired IP is not on this machine?
    # Error to handle: what if desired port is in use?
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM, 0) as sock:
        sock.bind((cfg.get_ip_addr(), cfg.get_port()))
        sock.listen(5)

        with context.wrap_socket(sock, server_side=True) as ssock:
            while True:
                conn, addr = ssock.accept()
                ct = threading.Thread(target=handle_connection, args=(cfg, conn, addr))
                ct.start()


def server_main(cfg, app):

    # Start the thread which will listen for connections.
    listen_thread = threading.Thread(target=server_listener, args=(cfg,))
    listen_thread.start()

    log_server("Nydus Server listening for connections on port {}...".format(cfg.get_port()))

    # Every so often trigger a thread to cleanup allocated accounts
    while True:
        cleanup_thread = threading.Thread(target=alloc_utils.cleanup, args=(cfg, app, ALLOCDB_LOCK))
        cleanup_thread.start()
        
        time.sleep(CLEANUP_PERIOD)

def main():

    nydus_info.request_version()

    restart_server_log()

    try:
        cfg = startup()
    except Exception:
        error_msg = traceback.format_exc()
        log_server(error_msg)
        exit(1)

    try:
        app = netauth.create_msal_app(cfg.get_msal_cid())
    except Exception:
        error_msg = traceback.format_exc()
        log_server(error_msg)
        exit(1)

    try:
        alloc_utils.initialise_accounts(cfg, app)
    except Exception:
        error_msg = traceback.format_exc()
        log_server(error_msg)

    log_server("Account authentication and allocation database setup are complete.")

    server_main(cfg, app)

main()
