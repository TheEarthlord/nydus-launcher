#!/usr/bin/python3

# Entry point of the nydus-launcher client.
# Decide which Minecraft version to launch.
# Use the json files under .minecraft to find all the jars we need.
# Request an account from the server.
# Launch Minecraft using those jars and account details.

import gi
import ssl
import socket
import threading
import traceback

gi.require_version("Gtk", "3.0")
gi.require_version("Wnck", "3.0")

from gi.repository import Gtk
from gi.repository import Wnck
from nydus.client import nodupe
from nydus.client import utils
from nydus.client.ClientConfig import ClientConfig
from nydus.client.ErrorDialog import ErrorDialog
from nydus.client.InfoDialog import InfoDialog
from nydus.client.MCLauncher import MCLauncher
from nydus.common.MCAccount import MCAccount
from nydus.common import nydus_info
from nydus.common import validity

MAXMSG = 1024

# Delimiter character used in allocation messages
# and how many of them a complete message will contain
ALLOC_DCHAR = ":"
ALLOC_DELIMS = 3

REQUEST_COMMAND = "REQUEST"
RELEASE_COMMAND = "RELEASE"

NETENC="utf-8"

MSG_END = "\n"

# A global for storing the numeric part of the Minecraft version we want
# to launch. Needed because the function which watches new windows
# needs to know the Minecraft version we're looking for, but Wnck doesn't
# allow flexibility in what we pass to it.
# We don't need a lock protecting this because we right to it only once, 
# strictly before launching the callback function which reads from it.
NUMERIC_VERSION = None

DIAG_LOCK = threading.Lock()

# Used to track which status dialog box we're up to
# showing as we work through the process of launching Minecraft.
# This is a global modified by several threads.
# Always use the DIAG_LOCK when touching it.
dialog_idx = 0

# The list of status dialog boxes in order, displaying
# stages in launching Minecraft.
# Those with timeouts of 0 will persist until the program
# reaches a new stage. The others swap out every few seconds
# to reassure the user the program is still running, should
# Minecraft take a while to appear on screen.
# Always use the DIAG_LOCK when opening or closing one of these windows.
DIALOGS = [
    InfoDialog("Requesting Minecraft credentials from server...", timeout=0),
    InfoDialog("Downloading files for Minecraft...", timeout=0),
    InfoDialog("Launching Minecraft..."),
    InfoDialog("Waiting for the grass to grow..."),
    InfoDialog("Spreading lava..."),
    InfoDialog("Making contact with the mothership..."),
    InfoDialog("Eroding a cliff-face..."),
    InfoDialog("The seconds are ticking by..."),
    InfoDialog("Circumnavigating the globe..."),
    InfoDialog("Crossing the desert on foot..."),
    InfoDialog("Journeying to the centre of the earth..."),
    InfoDialog("Watching trees grow..."),
    InfoDialog("Waiting for the sermon to be over..."),
    InfoDialog("Singing another chorus..."),
    InfoDialog("Following Pluto's orbit..."),
    InfoDialog("Stepping out of the time machine..."),
    InfoDialog("The elves are fading away..."),
    InfoDialog("Atlantis rises from the deeps..."),
    InfoDialog("Watching the years slip by..."),
    InfoDialog("Imminently expecting Jesus to return..."),
    InfoDialog("You have reached a state where time has no meaning...", timeout=0),
]

"""
Advances to showing the next dialog box in line, closing the current one.
If the next is to be open indefinitely, this is simple.
If the next has a specific timeout, this function starts the show_timed_dialogs
function to manage keeping windows open for the right durations.
"""
def show_next_dialog():
    global dialog_idx

    with DIAG_LOCK:

        if dialog_idx > 0:
            prev_diag = DIALOGS[dialog_idx-1]
            prev_diag.close()

        curr_diag = DIALOGS[dialog_idx]

        # If the current message does not have a specific timeout,
        # advance as normal.
        # If it has a timeout, start the thread which proceeds through
        # timed messages.
        if curr_diag.get_timeout() == 0:
            curr_diag.show_all()
            dialog_idx += 1
        else:
            timed_diag_thread = threading.Thread(target=show_timed_dialogs)
            timed_diag_thread.start()

"""
Displays an error dialog box and closes all others that might be open.
error_diag: string, the message to show in an error window.
"""
def show_error_dialog(error_diag):
    global dialog_idx

    win = ErrorDialog(error_diag)

    # Show error message until dismissed, then exit Gtk
    win.connect("destroy", Gtk.main_quit)

    with DIAG_LOCK:
        # Set to max so no more info messages appear
        dialog_idx = len(DIALOGS)

    close_all_dialogs()

    win.show_all()


"""
Closes all dialog boxes. Used if we're about to
shut down Gtk (Minecraft has finished opening) or
if we need to show an error dialog box.
"""
def close_all_dialogs():
    with DIAG_LOCK:
        for i in range(len(DIALOGS)):
            DIALOGS[i].close()


"""
This function is registered as a callback when Wnck detects
a new window opening. The function needs to determine
if the new window is Minecraft, and if so, close Gtk.
screen: the Gtk.Screen instance where the new window was detected
window: the Gtk.Window instance which is newly detected
"""
def watch_for_minecraft(screen, window):

    title = window.get_name()

    if not NUMERIC_VERSION:
        raise TypeError("Numeric Minecraft version should have been set before watching for the Minecraft window, but it was '{}'".format(NUMERIC_VERSION))

    if ("Minecraft" in title) and (NUMERIC_VERSION in title):

        close_all_dialogs()

        # Give the Gtk main loop an iteration to process the window closures
        # before we quit the main loop.
        Gtk.main_iteration()
        Gtk.main_quit()

"""
Called when a series of status dialog boxes with timeouts are due to be shown.
This function keeps each window open for the right time, then closes it and
moves on to the next one. Terminates if gtk shuts down, if it's time to stop
showing dialogs (communicated by dialog_idx being set out of bounds) or
if we reach a dialog box with no timeout.
"""
def show_timed_dialogs():
    
    global dialog_idx
    # We will enter this function directly from
    # show_next_message which will have detected a
    # timed message and not shown it yet.
    # So we show the next message ourselves.

    # We use a while True to make it easy to lock inside
    # the loop only when needed
    while True:

        with DIAG_LOCK:

            # If Gtk is no longer running, exit immediately.
            # The function which exited gtk will have already closed any current
            # messages.
            if Gtk.main_level() < 1:
                break

            # If we've exceeded the list of messages, exit immediately
            if dialog_idx >= len(DIALOGS):
                break

            # Else proceed to next message.
            curr_diag = DIALOGS[dialog_idx]
            curr_diag.show_all()
            if dialog_idx > 0:
                DIALOGS[dialog_idx-1].close()

            timeout = curr_diag.get_timeout()

            dialog_idx += 1


        # Outside lock so timeout sleeping will not
        # occupy the lock.
        if timeout > 0:
            time.sleep(timeout)
        else:
            # If timeout <= 0, leave message indefinitely.
            break

"""
After we close Minecraft, we establish another connection to
the server. This function uses it to release the Minecraft
account we were allocated.
"""
def release(ssock):

    sys_username = utils.get_username()
    request_str = "{} {}\n".format(RELEASE_COMMAND, sys_username)
    request_data = request_str.encode(encoding=NETENC)
    
    total_sent = 0
    while total_sent < len(request_data):
        total_sent += ssock.send(request_data)

    ssock.close()


"""
Once we've established connection with the server,
this function requests a Minecraft account and starts
the game.
"""
def request(ssock):

    global NUMERIC_VERSION
    
    sys_username = utils.get_username()
    request_str = "{} {}\n".format(REQUEST_COMMAND, sys_username)
    request_data = request_str.encode(encoding=NETENC)
    
    total_sent = 0
    while total_sent < len(request_data):
        total_sent += ssock.send(request_data)

    # Note you can be kept waiting for data forever
    # by a rogue server. Add some kind of timeout.
    str_data = ""
    received_count = -1
    while len(str_data) < MAXMSG:
        data = ssock.recv(MAXMSG)
        if len(data) == 0:
            # connection closed

            raise ConnectionAbortedError("Server closed connection; failed to get Minecraft account.")
            return

        received_count = len(data)
        str_data += data.decode(encoding=NETENC)

        if MSG_END in str_data:
            break

    num_delims = str_data.count(ALLOC_DCHAR)
    assert num_delims == ALLOC_DELIMS,\
            "Alloc message had incorrect number of delimiters; should have had {} but had {}"\
            .format(ALLOC_DELIMS, num_delims)

    str_data = str_data.rstrip(MSG_END)
    parts = str_data.split(ALLOC_DCHAR)

    ssock.close()

    mc_version = parts[0]
    mc_username = parts[1]
    mc_uuid = parts[2]
    mc_token = parts[3]

    assert validity.is_valid_minecraft_version(mc_version),\
            "Received invalid Minecraft version {}".format(mc_version)
    assert validity.is_valid_minecraft_username(mc_username),\
            "Received invalid Minecraft username {}".format(mc_username)
    assert validity.is_valid_minecraft_uuid(mc_uuid),\
            "Received invalid Minecraft uuid {}".format(mc_uuid)
    assert validity.is_valid_minecraft_token(mc_token),\
            "Received invalid Minecraft token {}".format(mc_token)

    show_next_dialog()

    mc_acc = MCAccount(mc_username, mc_uuid, mc_token)

    mc_instance = MCLauncher(mc_version, mc_acc)

    mc_instance.download_all()

    NUMERIC_VERSION = utils.get_version_numbers(mc_version)
    # Begin Wnck watching for the Minecraft window, so we know when
    # info dialog boxes will no longer be needed.
    # When Minecraft's window is detected, Gtk will shut down and
    # all dialog box related elements will exit.

    screen = Wnck.Screen.get_default()
    screen.force_update()
    screen.connect("window-opened", watch_for_minecraft)

    show_next_dialog()

    mc_instance.launch()

"""
To be run at the beginning of the program, before the server is
contacted. Checks for a pidfile, an indicator that a Nydus Client
instance is already running for this user on this machine, and if
one is present, exits immediately to avoid duplicate Minecraft
instances.
WARNING: This function will exit the whole program if the right conditions
are met, without presenting an error message for the user.
"""
def begin_pidfile():
    if nodupe.nydus_client_running():
        exit(0)

    nodupe.make_pidfile()

"""
To be run at the end of the program, after Minecraft is finished.
Deletes the pidfile.
"""
def end_pidfile():
    nodupe.delete_pidfile()

def client_main(cfg):

    begin_pidfile()

    show_next_dialog()

    context = ssl.create_default_context()

    # Manually add the self signed CA to the trusted store
    # Should we allow this to be configured, or require
    # that the cert be in system trusted store?
    # Error to handle: if cert doesn't exist
    context.load_verify_locations(cafile=cfg.get_ca_chain())

    # Error to handle: server ip not reachable
    # Error to handle: nothing listening on wanted port
    dest_ip = cfg.get_server_ip()
    with socket.create_connection((dest_ip, cfg.get_port())) as sock:
        with context.wrap_socket(sock, server_hostname=dest_ip) as ssock:
           
            request(ssock)

    # We only proceed when the Minecraft program terminates,
    # at which point we should release the account.

    with socket.create_connection((dest_ip, cfg.get_port())) as sock:
        with context.wrap_socket(sock, server_hostname=dest_ip) as ssock:
           
            release(ssock)

    end_pidfile()


def startup():
    cfg = ClientConfig()
    return cfg

def main():
    
    nydus_info.request_version()

    cfg = startup()

    # Enable graphical output for info and error windows
    gtk_thread = threading.Thread(target=Gtk.main)
    gtk_thread.start()

    try:
        client_main(cfg)
    except Exception:
        error_msg = traceback.format_exc()

        # Show the error both in a window and printed to stdout
        show_error_dialog(error_msg)
        print(error_msg)

    # If the client crashes, we want to make sure we
    # delete the pidfile so it doesn't block future launches
    if nodupe.pidfile_exists():
        end_pidfile()

main()
