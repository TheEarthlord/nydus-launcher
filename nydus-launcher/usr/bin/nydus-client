#!/usr/bin/python3

# Entry point of the nydus-launcher client.
# Decide which Minecraft version to launch.
# Use the json files under .minecraft to find all the jars we need.
# Request an account from the server.
# Launch Minecraft using those jars and account details.

import ssl
import socket
import threading
import tkinter as tk
from tkinter import ttk
import traceback

from nydus.client import utils
from nydus.client.StatusMsg import StatusMsg
from nydus.client.ClientConfig import ClientConfig
from nydus.client.MCVersion import MCVersion
from nydus.common.MCAccount import MCAccount
from nydus.common import validity

MAXMSG = 1024

# Delimiter character used in allocation messages
# and how many of them a complete message will contain
ALLOC_DCHAR = ":"
ALLOC_DELIMS = 3

REQUEST_COMMAND = "REQUEST"
RELEASE_COMMAND = "RELEASE"

NETENC="utf-8"

MSG_END = "\n"

WINDOW_TITLE = "Nydus Launcher"

# Used for tracking where we're up to in launching
# Minecraft, so we can display status message boxes
STATUS_MESSAGES = [
    StatusMsg(1, "Requesting Minecraft credentials from Server"),
    StatusMsg(2, "Downloading files for Minecraft"),
    StatusMsg(3, "Launching Minecraft"),
]

STATUS = 0
STATUS_LOCK = threading.Lock()

# In milliseconds
WINDOW_CHECK_PERIOD = 1000

# This function is called by tkinter root widgets
# to check if their status messages should still be
# shown or if they should be destroyed.
def check_window(root, msg_id):
    assert isinstance(root, tk.Tk), "Must pass a tkinter root for to check its status"
    assert isinstance(msg_id, int) and msg_id > 0, "Msg Id must be a positive integer"

    with STATUS_LOCK:

        if STATUS != msg_id:
            root.destroy()

        else:
            root.after(WINDOW_CHECK_PERIOD, check_window, root, msg_id)


def make_window(status_msg):
    assert isinstance(status_msg, StatusMsg), "Must pass a StatusMsg instance to create a status window. Instead, got a {}".format(type(status_msg))
    msg_text = status_msg.get_msg()
    msg_id = status_msg.get_id()

    root = tk.Tk(className=WINDOW_TITLE)
    frame = ttk.Frame(root, padding=10)
    frame.grid()
    ttk.Label(frame, text=msg_text).grid(column=0, row=0)
    root.after(WINDOW_CHECK_PERIOD, check_window, root, msg_id)

    root.mainloop()

"""
We have a sequence of status messages (describing which
stage of launching Minecraft we're up to) stored in the
STATUS_MESSAGES global.
They have sequentially incrementing message ids, starting
at 1.
So message in position x has id x+1.
We create a window for a message. The window periodically
checks the STATUS variable still matches its own id.
If the STATUS variable becomes something else (i.e. when
it advances to the next value) the existing status message
window vanishes.
Each time this function is called, STATUS is incremented,
(as well as the next message window being created) so just
call this function repeatedly to move through all the statuses.
Calling it after all statuses are exhausted should be harmless,
so the status messages will be gone when Minecraft actually
launches.
"""
def next_status_window():
    global STATUS

    with STATUS_LOCK:
        if STATUS < len(STATUS_MESSAGES):
            next_msg = STATUS_MESSAGES[STATUS]
            STATUS += 1
            window_thread = threading.Thread(target=make_window, args=(next_msg,))
            window_thread.start()
        else:
            STATUS += 1

"""
If an exception occurs, we want to display a message
window which tells us about it.
"""
def error_window(error_msg):
    assert validity.is_nonempty_str(error_msg)

    # If we've hit an error, we're no longer in the normal
    # procession of status messages and should end them.
    with STATUS_LOCK:
        STATUS = len(STATUS_MESSAGES)

    root = tk.Tk(className=WINDOW_TITLE)
    frame = ttk.Frame(root, padding=10)
    frame.grid()
    ttk.Label(frame, text=error_msg).grid(column=0, row=0)

    root.mainloop()

"""
Advance window status number beyond the last message
so all the windows close.
"""
def close_status_window():
    with STATUS_LOCK:
        STATUS = len(STATUS_MESSAGES)

"""
After we close Minecraft, we establish another connection to
the server. This function uses it to release the Minecraft
account we were allocated.
"""
def release(ssock):

    request_str = "{}\n".format(RELEASE_COMMAND)
    request_data = request_str.encode(encoding=NETENC)
    
    total_sent = 0
    while total_sent < len(request_data):
        total_sent += ssock.send(request_data)

    ssock.close()


"""
Once we've established connection with the server,
this function requests a Minecraft account and starts
the game.
"""
def request(ssock):
    
    next_status_window()

    sys_username = utils.get_username()
    request_str = "{} {}\n".format(REQUEST_COMMAND, sys_username)
    request_data = request_str.encode(encoding=NETENC)
    
    total_sent = 0
    while total_sent < len(request_data):
        total_sent += ssock.send(request_data)

    # Note you can be kept waiting for data forever
    # by a rogue server. Add some kind of timeout.
    str_data = ""
    received_count = -1
    while len(str_data) < MAXMSG:
        data = ssock.recv(MAXMSG)
        if len(data) == 0:
            # connection closed

            error_window("Server closed connection; failed to get Minecraft account.")
            return

        received_count = len(data)
        str_data += data.decode(encoding=NETENC)

        if MSG_END in str_data:
            break

    num_delims = str_data.count(ALLOC_DCHAR)
    assert num_delims == ALLOC_DELIMS,\
            "Alloc message had incorrect number of delimiters; should have had {} but had {}"\
            .format(ALLOC_DELIMS, num_delims)

    str_data = str_data.rstrip(MSG_END)
    parts = str_data.split(ALLOC_DCHAR)

    ssock.close()

    mc_version = parts[0]
    mc_username = parts[1]
    mc_uuid = parts[2]
    mc_token = parts[3]

    assert validity.is_valid_minecraft_version(mc_version),\
            "Received invalid Minecraft version {}".format(mc_version)
    assert validity.is_valid_minecraft_username(mc_username),\
            "Received invalid Minecraft username {}".format(mc_username)
    assert validity.is_valid_minecraft_uuid(mc_uuid),\
            "Received invalid Minecraft uuid {}".format(mc_uuid)
    assert validity.is_valid_minecraft_token(mc_token),\
            "Received invalid Minecraft token {}".format(mc_token)

    next_status_window()

    mc_acc = MCAccount(mc_username, mc_uuid, mc_token)

    mc_instance = MCVersion(mc_version, mc_acc)


    # Although launch() downloads all the files, we put a
    # separate download step first so we can mark it out
    # in the status window.
    mc_instance.download_all()

    next_status_window()

    mc_instance.launch()

    close_status_window()

def client_main(cfg):

    context = ssl.create_default_context()

    # Manually add the self signed CA to the trusted store
    # Should we allow this to be configured, or require
    # that the cert be in system trusted store?
    # Error to handle: if cert doesn't exist
    context.load_verify_locations(cafile=cfg.get_ca_chain())

    # Error to handle: server ip not reachable
    # Error to handle: nothing listening on wanted port
    dest_ip = cfg.get_server_ip()
    with socket.create_connection((dest_ip, cfg.get_port())) as sock:
        with context.wrap_socket(sock, server_hostname=dest_ip) as ssock:
           
            request(ssock)

    # We only proceed when the Minecraft program terminates,
    # at which point we should release the account.

    with socket.create_connection((dest_ip, cfg.get_port())) as sock:
        with context.wrap_socket(sock, server_hostname=dest_ip) as ssock:
           
            release(ssock)



def startup():
    cfg = ClientConfig()
    return cfg

def main():
    cfg = startup()

    try:
        client_main(cfg)
    except Exception:
        error_msg = traceback.format_exc()
        error_window(error_msg)

main()
