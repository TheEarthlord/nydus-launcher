#!/usr/bin/python3

# Entry point of the nydus-launcher client.
# Decide which Minecraft version to launch.
# Use the json files under .minecraft to find all the jars we need.
# Request an account from the server.
# Launch Minecraft using those jars and account details.

import gi
import ssl
import socket
import threading
import time
import traceback

gi.require_version("Gtk", "3.0")
gi.require_version("Wnck", "3.0")

from gi.repository import Gtk
from gi.repository import Wnck
from nydus.client import dialogs
from nydus.client import noduplication
from nydus.client import utils
from nydus.client.ClientConfig import ClientConfig
from nydus.client.MCLauncher import MCLauncher
from nydus.common.MCAccount import MCAccount
from nydus.common import nydus_info
from nydus.common import validity

MAXMSG = 1024

# Delimiter character used in allocation messages
# and how many of them a complete message will contain
ALLOC_DCHAR = ":"
ALLOC_DELIMS = 3

REQUEST_COMMAND = "REQUEST"
RELEASE_COMMAND = "RELEASE"

NETENC="utf-8"

MSG_END = "\n"

# A global for storing the numeric part of the Minecraft version we want
# to launch. Needed because the function which watches new windows
# needs to know the Minecraft version we're looking for, but Wnck doesn't
# allow flexibility in what we pass to it.
# We don't need a lock protecting this because we right to it only once, 
# strictly before launching the callback function which reads from it.
NUMERIC_VERSION = None


"""
This function is registered as a callback when Wnck detects
a new window opening. The function needs to determine
if the new window is Minecraft, and if so, close Gtk.
screen: the Gtk.Screen instance where the new window was detected
window: the Gtk.Window instance which is newly detected
"""
def watch_for_minecraft(screen, window):

    title = window.get_name()

    if not NUMERIC_VERSION:
        raise TypeError("Numeric Minecraft version should have been set before watching for the Minecraft window, but it was '{}'".format(NUMERIC_VERSION))

    if ("Minecraft" in title) and (NUMERIC_VERSION in title):

        dialogs.close_all_dialogs()

        # Give the Gtk main loop an iteration to process the window closures
        # before we quit the main loop.
        Gtk.main_iteration()
        Gtk.main_quit()


"""
After we close Minecraft, we establish another connection to
the server. This function uses it to release the Minecraft
account we were allocated.
"""
def release(ssock):

    sys_username = utils.get_username()
    request_str = "{} {}\n".format(RELEASE_COMMAND, sys_username)
    request_data = request_str.encode(encoding=NETENC)
    
    total_sent = 0
    while total_sent < len(request_data):
        total_sent += ssock.send(request_data[total_sent:])

    ssock.close()


"""
Once we've established connection with the server,
this function requests a Minecraft account and starts
the game.
"""
def request(ssock):

    global NUMERIC_VERSION
    
    sys_username = utils.get_username()
    request_str = "{} {}\n".format(REQUEST_COMMAND, sys_username)
    request_data = request_str.encode(encoding=NETENC)
    
    total_sent = 0
    while total_sent < len(request_data):
        total_sent += ssock.send(request_data[total_sent:])

    # Note you can be kept waiting for data forever
    # by a rogue server. Add some kind of timeout.
    str_data = ""
    received_count = -1
    while len(str_data) < MAXMSG:
        data = ssock.recv(MAXMSG)
        if len(data) == 0:
            # connection closed

            raise ConnectionAbortedError("Server closed connection; failed to get Minecraft account.")
            return

        received_count = len(data)
        str_data += data.decode(encoding=NETENC)

        if MSG_END in str_data:
            break

    num_delims = str_data.count(ALLOC_DCHAR)
    assert num_delims == ALLOC_DELIMS,\
            "Alloc message had incorrect number of delimiters; should have had {} but had {}"\
            .format(ALLOC_DELIMS, num_delims)

    str_data = str_data.rstrip(MSG_END)
    parts = str_data.split(ALLOC_DCHAR)

    ssock.close()

    mc_version = parts[0]
    mc_username = parts[1]
    mc_uuid = parts[2]
    mc_token = parts[3]

    assert validity.is_valid_minecraft_version(mc_version),\
            "Received invalid Minecraft version {}".format(mc_version)
    assert validity.is_valid_minecraft_username(mc_username),\
            "Received invalid Minecraft username {}".format(mc_username)
    assert validity.is_valid_minecraft_uuid(mc_uuid),\
            "Received invalid Minecraft uuid {}".format(mc_uuid)
    assert validity.is_valid_minecraft_token(mc_token),\
            "Received invalid Minecraft token {}".format(mc_token)

    dialogs.show_next_dialog()

    mc_acc = MCAccount(mc_username, mc_uuid, mc_token)

    mc_instance = MCLauncher(mc_version, mc_acc)

    mc_instance.download_all()

    NUMERIC_VERSION = utils.get_version_numbers(mc_version)
    # Begin Wnck watching for the Minecraft window, so we know when
    # info dialog boxes will no longer be needed.
    # When Minecraft's window is detected, Gtk will shut down and
    # all dialog box related elements will exit.

    screen = Wnck.Screen.get_default()
    screen.force_update()
    screen.connect("window-opened", watch_for_minecraft)

    dialogs.show_next_dialog()

    mc_instance.launch()



def client_main(cfg):

    dialogs.show_next_dialog()

    context = ssl.create_default_context()

    # Manually add the self signed CA to the trusted store
    # Should we allow this to be configured, or require
    # that the cert be in system trusted store?
    # Error to handle: if cert doesn't exist
    context.load_verify_locations(cafile=cfg.get_ca_chain())

    # Error to handle: server ip not reachable
    # Error to handle: nothing listening on wanted port
    dest_ip = cfg.get_server_ip()
    with socket.create_connection((dest_ip, cfg.get_port())) as sock:
        with context.wrap_socket(sock, server_hostname=dest_ip) as ssock:
           
            request(ssock)

    # We only proceed when the Minecraft program terminates,
    # at which point we should release the account.

    with socket.create_connection((dest_ip, cfg.get_port())) as sock:
        with context.wrap_socket(sock, server_hostname=dest_ip) as ssock:
           
            release(ssock)


def startup():
    cfg = ClientConfig()
    return cfg


def main():
    
    nydus_info.request_version()

    # Will exit program if a pidfile is already present, indicating
    # a second instance of Nydus Client.
    noduplication.setup_pidfile()

    cfg = startup()

    # Enable graphical output for info and error windows
    gtk_thread = threading.Thread(target=Gtk.main)
    gtk_thread.start()

    try:
        client_main(cfg)
    except Exception:
        error_msg = traceback.format_exc()

        # Show the error both in a window and printed to stdout
        dialogs.show_error_dialog(error_msg)
        print(error_msg)

    # We want to make sure we delete the pidfile, even if we
    # crashed from the main client, so we don't leave future
    # clients blocked.
    noduplication.delete_pidfile()

main()
